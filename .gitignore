# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Data / artifacts (regenerable — keep the generators, not the outputs)
artifacts/datasets/
artifacts/checkpoints/
artifacts/results/
artifacts/tokenizer/
artifacts/reproduced/
experiments/*/output/
!artifacts/manifests/

# Book build outputs
book/*.pdf
# committed build intermediates — regenerable, never cite them:
#   book/_assembled.md   <- python book/assemble.py
#   book/_for_review.md  <- cat book/manuscript/*.md
book/_assembled.md
book/_for_review.md
book/latex/*.aux
book/latex/*.log
book/latex/*.out
book/latex/*.toc
book/latex/*.lof
book/latex/_md/
book/latex/chapters/

# OS / editor
.DS_Store
.vscode/
.idea/

# Python virtualenvs (any name)
.venv*/
