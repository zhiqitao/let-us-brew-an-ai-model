# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Data / artifacts (regenerable — keep the generators, not the outputs)
artifacts/datasets/
artifacts/checkpoints/
artifacts/results/
artifacts/tokenizer/
artifacts/reproduced/
experiments/*/output/
!artifacts/manifests/

# Book build outputs
book/*.pdf
# ...except the pinned release artifact: its sha256+page_count are pinned in
# docs/release_manifest.json, so it must ship in the release to be verifiable
# from a clean clone (round-2 R2-EX-N06; the EPUB counterpart is tracked too).
!book/let-us-brew-an-ai-model-v20261001.pdf
# committed build intermediates — regenerable, never cite them:
#   book/_assembled.md   <- python book/assemble.py
#   book/_for_review.md  <- cat book/manuscript/*.md
#   book/_epub.md        <- python book/build_epub.py
book/_assembled.md
book/_for_review.md
book/_epub.md
book/latex/*.aux
book/latex/*.log
book/latex/*.out
book/latex/*.toc
book/latex/*.lof
book/latex/_md/
book/latex/chapters/

# OS / editor
.DS_Store
.vscode/
.idea/

# Python virtualenvs (any name)
.venv*/
